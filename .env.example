# Environment Configuration Template
# Copy this to .env and fill in your actual values

# Ollama Configuration (Local LLM)
# Make sure Ollama is running at the base URL specified below
OLLAMA_MODEL=llama2
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model
# Options: all-minilm (local), text-embedding-3-small (OpenAI)
EMBEDDING_MODEL=all-minilm

# Vision Model  
# Options: llava (local), gpt-4o (OpenAI)
VISION_MODEL=llava

# Vector Store
CHROMA_DB_PATH=./chroma_db_legal
CHROMA_COLLECTION_NAME=legal_documents

# PDF Processing
PDF_EXTRACTION_METHOD=marker
MAX_PAGES=500
EXTRACT_IMAGES=true

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
SECTION_AWARE_CHUNKING=true

# Text Cleaning
REMOVE_BOILERPLATE=true
REMOVE_PAGE_NUMBERS=true
NORMALIZE_WHITESPACE=true

# Data Directories
DATASET_CACHE_DIR=./data/cache
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/legal_system.log
